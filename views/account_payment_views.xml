<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_supplier_quedan" model="ir.ui.view">
        <field name="name">account.payment.form.account_supplier_quedan</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Pago a proveedor = partner_type 'supplier' + payment_type 'outbound'
                 (un reembolso de proveedor es 'inbound' y no lleva Quedan). -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_print_supplier_quedan" string="Imprimir Quedan" type="object"
                        icon="fa-print"
                        invisible="partner_type != 'supplier' or payment_type != 'outbound' or (state in ('canceled', 'rejected') and not supplier_quedan_number)"/>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='memo']" position="after">
                <field name="supplier_quedan_days"
                       invisible="partner_type != 'supplier' or payment_type != 'outbound'"/>
                <field name="supplier_quedan_number"
                       invisible="partner_type != 'supplier' or payment_type != 'outbound' or not supplier_quedan_number"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <div name="supplier_quedan_documents" class="mt-3"
                     invisible="partner_type != 'supplier' or payment_type != 'outbound'">
                    <field name="supplier_quedan_documents_mismatch" invisible="1"/>
                    <separator string="Documentos del Quedan"/>
                    <div class="text-muted small mb-2">
                        Estos documentos son únicamente informativos para el Quedan y no crean ni modifican
                        vínculos contables con facturas.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not supplier_quedan_documents_mismatch">
                        La suma de los documentos del Quedan no coincide con el importe del pago.
                    </div>
                    <field name="supplier_quedan_document_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="number"/>
                            <field name="reference"/>
                            <field name="date"/>
                            <field name="amount"/>
                        </list>
                    </field>
                    <div class="text-end mt-1" invisible="not supplier_quedan_document_ids">
                        <strong>Total documentos: </strong>
                        <field name="supplier_quedan_manual_documents_total" class="oe_inline"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
